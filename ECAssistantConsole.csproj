<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ECAssistantConsole</RootNamespace>
    <AssemblyName>ecassistant</AssemblyName>
    <PackageId>ECAssistant.Console</PackageId>
    <Version>1.0.8</Version>
    <Authors>SideDevEC</Authors>
    <Description>ECAssistant Console — the local AI agent for your terminal. Install once, chat with a fully local LLM-powered agent.</Description>
    <PackageTags>ecassistant;ai-agent;local-llm;cli;terminal</PackageTags>
    <PackageProjectUrl>https://github.com/SideDevEC/ECAssistantConsole</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ecassistant</ToolCommandName>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <!-- Test project lives in ./Tests and must not compile into the app assembly -->
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Strict dependency chain: Console → TUI → Core. The Console never touches
         Core types directly — everything goes through ECAssistant.TUI.Hosting.
         Core flows transitively via the TUI package (incl. DataProtection for
         SecureKeyStore). -->
    <PackageReference Include="ECAssistant.TUI" Version="12.9.11" Condition="'$(EcaUseProjectRefs)' != 'true'" />
    <ProjectReference Include="../ECAssistantTUI/ECAssistant.TUI.csproj" Condition="'$(EcaUseProjectRefs)' == 'true'" />
    <!-- LLM server is NOT embedded: the tool stays thin and FirstRunSetup downloads
         ECAssistant.LLM.Server from nuget.org at wizard time (see Setup/NuGetServerFetcher.cs).
         Keep FirstRunSetup.LlmServerPackageVersion in sync with the released server version. -->
  </ItemGroup>

</Project>