<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ECAssistantConsole</RootNamespace>
    <AssemblyName>ecassistant</AssemblyName>
    <PackageId>ECAssistant.Console</PackageId>
    <Version>1.0.6</Version>
    <Authors>SideDevEC</Authors>
    <Description>ECAssistant Console — the local AI agent for your terminal. Install once, chat with a fully local LLM-powered agent.</Description>
    <PackageTags>ecassistant;ai-agent;local-llm;cli;terminal</PackageTags>
    <PackageProjectUrl>https://github.com/SideDevEC/ECAssistantConsole</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ecassistant</ToolCommandName>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <!-- Test project lives in ./Tests and must not compile into the app assembly -->
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECAssistant.Core" Version="12.9.8" />
    <PackageReference Include="ECAssistant.Core.TestSupport" Version="12.9.8" />
    <PackageReference Include="ECAssistant.TUI" Version="12.9.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="System.Text.Json" Version="10.0.4" />
    <!-- Core is consumed as a package, but its DataProtection deps may not flow everywhere —
         SecureKeyStore needs DataProtection at runtime — reference explicitly. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.11" />
    <!-- LLM server is NOT embedded: the tool stays thin and FirstRunSetup downloads
         ECAssistant.LLM.Server from nuget.org at wizard time (see Setup/NuGetServerFetcher.cs).
         Keep FirstRunSetup.LlmServerPackageVersion in sync with the released server version. -->
  </ItemGroup>

</Project>