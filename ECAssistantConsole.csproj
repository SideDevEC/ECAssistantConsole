<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ECAssistantConsole</RootNamespace>
    <AssemblyName>ecassistant</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test project lives in ./Tests and must not compile into the app assembly -->
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ECAssistant.Core">
      <HintPath>lib\ECAssistant.Core.dll</HintPath>
    </Reference>
    <Reference Include="ECAssistant.Core.TestSupport">
      <HintPath>lib\ECAssistant.Core.TestSupport.dll</HintPath>
    </Reference>
    <Reference Include="ECAssistant.TUI">
      <HintPath>lib\ECAssistant.TUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="System.Text.Json" Version="10.0.4" />
    <!-- LLM server runtime as NuGet content files. NuGet places server/ in the output directory.
         The wizard copies it to ~/.ECAssistantLLM/server/ on first install. -->
    <PackageReference Include="ECAssistant.LLM.Server" Version="14.7.4" />
  </ItemGroup>

</Project>