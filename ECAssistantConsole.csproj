<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ECAssistantConsole</RootNamespace>
    <AssemblyName>ecassistant</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test project lives in ./Tests and must not compile into the app assembly -->
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECAssistant.Core" Version="12.9.2" />
    <PackageReference Include="ECAssistant.Core.TestSupport" Version="12.9.2" />
    <PackageReference Include="ECAssistant.TUI" Version="12.9.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="System.Text.Json" Version="10.0.4" />
    <!-- Core is consumed as a package, but its DataProtection deps may not flow everywhere —
         SecureKeyStore needs DataProtection at runtime — reference explicitly. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.11" />
    <!-- LLM server runtime as NuGet content files. NuGet places server/ in the output directory.
         The wizard copies it to ~/.ECAssistantLLM/server/ on first install. -->
    <PackageReference Include="ECAssistant.LLM.Server" Version="14.7.8" />
  </ItemGroup>

</Project>