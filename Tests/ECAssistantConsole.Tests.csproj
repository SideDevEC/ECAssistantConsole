<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>ECAssistantConsole.Tests</AssemblyName>
    <RootNamespace>ECAssistantConsole.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Dev-only test suite: may reference Core/TestSupport directly — this csproj is
       never packed, so the shipped dependency chain (Console → TUI → Core) is unaffected. -->
  <ItemGroup>
    <ProjectReference Include="..\ECAssistantConsole.csproj" />
    <PackageReference Include="ECAssistant.Core" Version="12.9.11" />
  </ItemGroup>

  <!-- TestSupport: own repo (sibling). Local dev → project ref; CI/NuGet → package.
       Dev-only test suite — this csproj is never packed and never built in CI,
       so the shipped dependency chain (Console → TUI → Core) is unaffected. -->
  <ItemGroup Condition="'$(EcaUseProjectRefs)' == 'true'">
    <ProjectReference Include="..\..\ECAssistantTestSupport\ECAssistant.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EcaUseProjectRefs)' != 'true'">
    <PackageReference Include="ECAssistant.TestSupport" Version="12.9.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
