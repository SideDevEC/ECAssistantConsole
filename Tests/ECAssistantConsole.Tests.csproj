<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>ECAssistantConsole.Tests</AssemblyName>
    <RootNamespace>ECAssistantConsole.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Dev-only test suite: may reference Core/TestSupport directly — this csproj is
       never packed, so the shipped dependency chain (Console → TUI → Core) is unaffected. -->
  <ItemGroup>
    <ProjectReference Include="..\ECAssistantConsole.csproj" />
    <PackageReference Include="ECAssistant.Core" Version="12.9.9" />
    <!-- TestSupport is an internal harness in the Core repo (never on NuGet).
         Dev-only relative reference — all repos live side-by-side under ~/Agent/;
         this csproj is never built in CI. -->
    <ProjectReference Include="..\..\ECAssistantCore\TestSupport\ECAssistant.Core.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
